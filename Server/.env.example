# --- Server Parameters ---
PORT=3000
MONGODB_URI=mongodb+srv://your_user:your_pass@cluster.mongodb.net/database_name
JWT_SECRET=your_super_secret_key_change_this_for_production
CLIENT_URL=http://your-production-app.vercel.app

# --- AI & External Services ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Email Notifications (GMAIL) ---
GOOGLE_USER=your-email@gmail.com
GMAIL_PASS=your-google-app-password

# --- Deployment Environment ---
NODE_ENV=production
